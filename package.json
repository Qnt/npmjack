{
  "name": "npmjack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000 --host",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "vitest run",
    "typecheck": "bunx tsgo --noEmit",
    "typecheck:tsc": "bunx tsc --noEmit",
    "typecheck:tsgo": "bunx tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/silkscreen": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-router-ssr-query": "1.166.11",
    "@tanstack/react-start": "1.167.45",
    "@tanstack/router-plugin": "1.167.23",
    "clsx": "^2.1.1",
    "ofetch": "^1.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260424.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
